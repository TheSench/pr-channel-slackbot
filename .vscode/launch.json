{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Action Locally",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/src/index.mjs",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "INPUT_CONFIG-FILE": "${workspaceFolder}/config.json",
                "INPUT_STATE-FILE": "${workspaceFolder}/.github/pr-channel-state.json",
                "GITHUB_WORKSPACE": "${workspaceFolder}"
            },
            "console": "internalConsole"
        }
    ]
}
